static var _all: Array = []


## Tüm yetenekler düz liste olarak (önbellekli)
static func all() -> Array:
	if _all.is_empty():
		for cat in DATA:
			for s in DATA[cat]:
				_all.append({"name": s[0], "cat": cat, "type": s[1], "desc": s[2], "tags": s[3] if s.size() > 3 else ""})
	return _all


static func categories() -> Array:
	return DATA.keys()


## Karakter defterine konacak kopya
static func make_entry(s: Dictionary) -> Dictionary:
	return {"name": s.get("name", "Yeni Yetenek"), "cat": s.get("cat", ""), "type": s.get("type", "Aktif"),
			"desc": s.get("desc", ""), "notes": "", "tags": s.get("tags", "")}
